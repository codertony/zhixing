{
  "name": "zhixing",
  "version": "0.1.0",
  "private": true,
  "description": "知行智能研发认知操作平台 - ZhiXing CogniAction OS",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:api": "dotenv -e .env.local -- pnpm --filter @zhixing/api dev",
    "dev:web": "dotenv -e .env.local -- pnpm --filter @zhixing/web dev",
    "dev:mcp": "dotenv -e .env.local -- pnpm --filter @zhixing/mcp-server dev",
    "lint": "turbo run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:migrate": "pnpm --filter @zhixing/db db:migrate",
    "db:generate": "pnpm --filter @zhixing/db db:generate",
    "publish:cli": "bash scripts/publish-cli.sh",
    "infra:up": "docker-compose up -d 2>nul || podman-compose up -d 2>nul || podman compose up -d",
    "infra:down": "docker-compose down 2>nul || podman-compose down 2>nul || podman compose down",
    "infra:logs": "docker-compose logs -f 2>nul || podman-compose logs -f 2>nul || podman compose logs -f",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^1.2.0",
    "@vitest/ui": "^1.2.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.56.0",
    "husky": "^9.0.0",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^1.2.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
