{
  "name": "zhixing",
  "version": "0.0.1",
  "private": true,
  "description": "知行 (ZhiXing) 智能研发认知操作平台",
  "keywords": [
    "ai-native",
    "spec-driven",
    "mcp",
    "devops"
  ],
  "author": "ZhiXing Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:migrate": "pnpm --filter @zhixing/db migrate",
    "db:generate": "pnpm --filter @zhixing/db generate",
    "db:seed": "pnpm --filter @zhixing/db seed",
    "db:reset": "pnpm --filter @zhixing/db reset",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=!@zhixing/web && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@zhixing/eslint-config": "workspace:*",
    "prettier": "^3.2.5",
    "turbo": "^1.12.4"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
