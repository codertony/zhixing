{
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "WebFetch",
      "Grep",
      "Glob",
      "LS",
      "MultiEdit",
      "WebSearch",
      "Skill",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "AskUserQuestion",
      "Bash(git -C \"E:/workSpace/ZhiXing\" status)",
      "Bash(git -C \"E:/workSpace/ZhiXing\" log --oneline -3)",
      "Bash(git -C \"E:/workSpace/ZhiXing\" add .gitignore)",
      "Bash(git -C:*)",
      "Bash(dir:*)",
      "Bash(echo:*)",
      "Bash(cmd.exe /c:*)",
      "Bash(git config:*)",
      "Bash(openspec list:*)",
      "Bash(openspec new change:*)",
      "Bash(openspec status:*)",
      "Bash(openspec instructions proposal:*)",
      "Bash(openspec instructions design:*)",
      "Bash(openspec instructions specs:*)",
      "Bash(openspec instructions tasks:*)",
      "Bash(pnpm install)",
      "Bash(pnpm dev)",
      "Bash(pnpm build)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)"
    ],
    "deny": [
      "Bash(*>*.env*)",
      "Bash(*>*.env.local*)",
      "Bash(*secrets*)",
      "Bash(*password*)",
      "Bash(*token*)"
    ],
    "defaultMode": "acceptEdits",
    "protectedFiles": [
      ".env",
      ".env.local",
      ".env.production",
      "**/secrets.yaml",
      "**/secrets.json",
      "**/*.pem",
      "**/*.key"
    ]
  },
  "enabledPlugins": {
    "ralph-wiggum@claude-code-plugins": true,
    "superpowers@superpowers-marketplace": true,
    "everything-claude-code@everything-claude-code": true
  }
}
