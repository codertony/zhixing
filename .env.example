# 知行平台本地开发环境配置
# 复制此文件为 .env.local 并填写实际值

# ===========================================
# 数据库配置
# ===========================================

# PostgreSQL 连接字符串
DATABASE_URL="postgresql://zhixing:zhixing_dev_password@localhost:5432/zhixing"

# ===========================================
# 向量数据库配置
# ===========================================

# Qdrant REST API 地址
QDRANT_URL="http://localhost:6333"

# Qdrant gRPC 地址
QDRANT_GRPC_URL="http://localhost:6334"

# ===========================================
# 大模型中转代理配置
# ===========================================

# OpenAI API 代理地址（通过中转代理）
OPENAI_BASE_URL="https://api.openai.com/v1"

# OpenAI API Key
OPENAI_API_KEY="your-openai-api-key-here"

# Anthropic API 代理地址（通过中转代理）
# ANTHROPIC_BASE_URL="https://api.anthropic.com"

# ===========================================
# GitLab 配置
# ===========================================

# GitLab 服务器地址
GITLAB_URL="https://gitlab.example.com"

# GitLab Personal Access Token
GITLAB_TOKEN="your-gitlab-token-here"

# ===========================================
# 服务配置
# ===========================================

# 服务端口
PORT=3000

# Node 环境
NODE_ENV="development"

# 日志级别
LOG_LEVEL="debug"

# ===========================================
# 认知层配置
# ===========================================

# Embedding 模型
EMBEDDING_MODEL="text-embedding-3-small"

# Embedding 维度
EMBEDDING_DIMENSION=1536

# 索引批次大小
INDEX_BATCH_SIZE=100

# ===========================================
# MCP Server 配置
# ===========================================

# MCP Server 名称
MCP_SERVER_NAME="zhixing-cognitive"

# MCP Server 版本
MCP_SERVER_VERSION="0.1.0"
